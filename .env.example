# Copy to root .env. The bundle build reads it automatically.
# install.sh fills blank service tokens and host-specific fields on the server.
SERVICE_TOKEN=
ADMIN_TOKEN=
MODEL_GATEWAY_TOKEN=
DEPLOY_ROOT=
COMPOSE_PROJECT_NAME=opencode_cloud
API_PORT=18080
HTTPS_PORT=443
DOCKER_BRIDGE_IP=

# Two upstream credentials shared by Code and Data Agents.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3

# Optional accounts join the same global model automatically when nonempty.
MINIMAX_API_KEY_2=
ZAI_API_KEY_2=

# Empty means no preset Agents. Example: code:glm,data:minimax
PRESET_AGENTS=
# Restore an exported configuration instead of the simple model/Agent presets.
BOOTSTRAP_BUNDLE=
# Required only for an encrypted export.
BOOTSTRAP_PASSWORD=
