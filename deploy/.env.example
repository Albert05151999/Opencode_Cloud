# Only fill these two keys. Keep this file local.
ZAI_API_KEY=
MINIMAX_API_KEY=

# OpenAI Chat Completions via LiteLLM; fast=M3, quality=GLM-5.3.
# Slots 1/2 share one provider endpoint; they are NOT independent replicas.
CODING_FAST_API_KEY=${MINIMAX_API_KEY}
CODING_FAST_MODEL=openai/MiniMax-M3
CODING_FAST_1_API_BASE=https://api.minimaxi.com/v1
CODING_FAST_2_API_BASE=https://api.minimaxi.com/v1

CODING_QUALITY_API_KEY=${ZAI_API_KEY}
CODING_QUALITY_MODEL=openai/glm-5.3
CODING_QUALITY_1_API_BASE=https://api.z.ai/api/coding/paas/v4
CODING_QUALITY_2_API_BASE=https://api.z.ai/api/coding/paas/v4

DATA_FAST_API_KEY=${MINIMAX_API_KEY}
DATA_FAST_MODEL=openai/MiniMax-M3
DATA_FAST_1_API_BASE=https://api.minimaxi.com/v1
DATA_FAST_2_API_BASE=https://api.minimaxi.com/v1

DATA_QUALITY_API_KEY=${ZAI_API_KEY}
DATA_QUALITY_MODEL=openai/glm-5.3
DATA_QUALITY_1_API_BASE=https://api.z.ai/api/coding/paas/v4
DATA_QUALITY_2_API_BASE=https://api.z.ai/api/coding/paas/v4
